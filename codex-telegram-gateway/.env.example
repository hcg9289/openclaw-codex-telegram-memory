TELEGRAM_BOT_TOKEN=replace_me
TELEGRAM_ALLOWED_USERS=123456789
CODEX_BIN=/usr/bin/codex
CODEX_WORKDIR=/root
CODEX_TIMEOUT_SECONDS=18000
STATE_DIR=/var/lib/codex-telegram-gateway
MAX_RECENT_TURNS=20
MAX_ACTIVE_WORK_TASKS=2
TASK_SUPERVISOR_INTERVAL_SECONDS=60
TASK_STALE_SECONDS=900
WATCH_STALE_SECONDS=900
SUPERVISION_COOLDOWN_SECONDS=900
MAX_SUPERVISION_TASKS_PER_PARENT=3
