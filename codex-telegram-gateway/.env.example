# Copy to /opt/codex-telegram-gateway/.env and fill real values on the VPS.
# Do not commit the real .env file.

TELEGRAM_BOT_TOKEN=replace_with_telegram_bot_token
TELEGRAM_ALLOWED_USERS=123456789

CODEX_BIN=/usr/bin/codex
CODEX_WORKDIR=/root
CODEX_TIMEOUT_SECONDS=18000
CODEX_WATCHER_INTERVAL_SECONDS=600
CODEX_WATCH_RESUME_TIMEOUT_SECONDS=900

STATE_DIR=/var/lib/codex-telegram-gateway
MAX_RECENT_TURNS=20
MESSAGE_BATCH_DELAY_SECONDS=8
MAX_ACTIVE_WORK_TASKS=2
TASK_UNIT_PREFIX=codex-telegram-task
TASK_SUPERVISOR_INTERVAL_SECONDS=60

MEMORY_ENV_PATH=/opt/openclaw-memory/config/memory.env
COGNEE_PYTHON=/opt/openclaw-memory/venv/bin/python
COGNEE_DATASET=openclaw_memory
COGNEE_WRITE_DATASET=openclaw_memory_v2
COGNEE_RECALL_DATASETS=openclaw_memory_v2,openclaw_memory
COGNEE_RECALL_TOP_K=5
COGNEE_TIMEOUT_SECONDS=45
MEMORY_WRITER_COGNEE_TIMEOUT_SECONDS=900

MEMORY_CURATOR_CODEX_MODEL=gpt-5.5
MEMORY_CURATOR_CODEX_TIMEOUT_SECONDS=1800

# Legacy orchestrator/job code is included for history compatibility.
ORCHESTRATOR_DURABLE_JOBS=1
ORCHESTRATOR_MAX_PARALLEL=2
ORCHESTRATOR_PLANNER_TIMEOUT_SECONDS=900
ORCHESTRATOR_WORKER_TIMEOUT_SECONDS=1200
ORCHESTRATOR_REPORTER_TIMEOUT_SECONDS=900
ORCHESTRATOR_ROUTER_TIMEOUT_SECONDS=90
