# Copy to /opt/openclaw-memory/config/memory.env and fill real values on the VPS.
# Do not commit real API keys, DB passwords, or local secrets.

LLM_PROVIDER=openai
LLM_MODEL=openai/gpt-5.5
LLM_ENDPOINT=http://127.0.0.1:18082/v1
LLM_API_KEY=local-codex-proxy

BAML_LLM_PROVIDER=openai
BAML_LLM_MODEL=openai/gpt-5.5
BAML_LLM_ENDPOINT=http://127.0.0.1:18082/v1
BAML_LLM_API_KEY=local-codex-proxy

EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_ENDPOINT=http://127.0.0.1:11434

VECTOR_DB_PROVIDER=pgvector
GRAPH_DATABASE_PROVIDER=kuzu

OPENCLAW_MEMORY_ROOT=/opt/openclaw-memory
