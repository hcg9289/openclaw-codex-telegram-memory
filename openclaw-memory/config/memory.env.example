# Copy to /opt/openclaw-memory/config/memory.env and fill real values on the VPS.
# Do not commit real API keys, DB passwords, or local secrets.

LLM_PROVIDER=openai
LLM_MODEL=openai/gpt-5.5
LLM_ENDPOINT=http://127.0.0.1:18082/v1
LLM_API_KEY=local-codex-proxy

BAML_LLM_PROVIDER=openai
BAML_LLM_MODEL=openai/gpt-5.5
BAML_LLM_ENDPOINT=http://127.0.0.1:18082/v1
BAML_LLM_API_KEY=local-codex-proxy

EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_ENDPOINT=http://127.0.0.1:11434/api/embed
EMBEDDING_DIMENSIONS=768
EMBEDDING_API_KEY=ollama-local
HUGGINGFACE_TOKENIZER=bert-base-uncased

VECTOR_DB_PROVIDER=pgvector
VECTOR_DATASET_DATABASE_HANDLER=pgvector
VECTOR_DB_HOST=127.0.0.1
VECTOR_DB_PORT=15432
VECTOR_DB_NAME=openclaw_memory
VECTOR_DB_USERNAME=openclaw_memory
VECTOR_DB_PASSWORD=replace_with_generated_password

GRAPH_DATABASE_PROVIDER=kuzu
GRAPH_DATASET_DATABASE_HANDLER=kuzu
GRAPH_FILE_PATH=/opt/openclaw-memory/system/databases

DB_PROVIDER=postgres
DB_HOST=127.0.0.1
DB_PORT=15432
DB_NAME=openclaw_memory
DB_USERNAME=openclaw_memory
DB_PASSWORD=replace_with_generated_password

MIGRATION_DB_PROVIDER=postgres
MIGRATION_DB_HOST=127.0.0.1
MIGRATION_DB_PORT=15432
MIGRATION_DB_NAME=openclaw_memory
MIGRATION_DB_USERNAME=openclaw_memory
MIGRATION_DB_PASSWORD=replace_with_generated_password

POSTGRES_DB=openclaw_memory
POSTGRES_USER=openclaw_memory
POSTGRES_PASSWORD=replace_with_generated_password

OPENCLAW_MEMORY_ROOT=/opt/openclaw-memory
DATA_ROOT_DIRECTORY=/opt/openclaw-memory/data
SYSTEM_ROOT_DIRECTORY=/opt/openclaw-memory/system
CACHE_ROOT_DIRECTORY=/opt/openclaw-memory/cache
COGNEE_LOGS_DIR=/opt/openclaw-memory/logs
ENABLE_BACKEND_ACCESS_CONTROL=false
COGNEE_CLI_MODE=true
COGNEE_LOG_FILE=true
COGNEE_SKIP_CONNECTION_TEST=false
