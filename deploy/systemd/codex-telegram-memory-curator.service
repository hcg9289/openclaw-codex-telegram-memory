[Unit]
Description=Codex Telegram Gateway Memory Curator
After=network-online.target codex-telegram-gateway.service

[Service]
Type=oneshot
WorkingDirectory=/opt/codex-telegram-gateway
EnvironmentFile=-/opt/codex-telegram-gateway/.env
ExecStart=/usr/bin/python3 /opt/codex-telegram-gateway/memory_curator.py --once --limit 1
NoNewPrivileges=true
PrivateTmp=true

