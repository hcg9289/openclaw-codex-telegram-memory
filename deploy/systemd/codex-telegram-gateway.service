[Unit]
Description=Codex Telegram Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/codex-telegram-gateway
EnvironmentFile=/opt/codex-telegram-gateway/.env
ExecStart=/usr/bin/python3 /opt/codex-telegram-gateway/gateway.py
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
